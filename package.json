{
  "name": "meine-familienakte",
  "private": true,
  "version": "2.28.1",
  "type": "module",
  "description": "Private Familienakte im Browser – Unterlagen, Termine und Aufgaben übersichtlich geordnet.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/run-all-checks.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  }
}
