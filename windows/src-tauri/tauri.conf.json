{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meine Familienakte",
  "mainBinaryName": "familienakte",
  "version": "2.28.14",
  "identifier": "de.familyprojekt.familienakte",
  "build": {
    "frontendDist": "../../dist",
    "beforeBuildCommand": "node tools/build-web.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Meine Familienakte",
        "url": "index.html",
        "width": 1280,
        "height": 900,
        "minWidth": 360,
        "minHeight": 480,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": ["pro-tresor/familienakte-tresor.jar", "pro-tresor/runtime/**/*"],
    "targets": [
      "nsis"
    ],
    "publisher": "Familienakte",
    "category": "Productivity",
    "shortDescription": "Private Familienakte: Unterlagen, Fristen und Tagebuch der Familie",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English"
        ]
      }
    }
  }
}
