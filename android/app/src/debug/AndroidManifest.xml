<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <application>
  <!-- Only debug APKs. Other apps get access only through the real DocumentsUI grant. -->
  <provider android:name=".PairDocuments" android:authorities="${applicationId}.pair.documents"
   android:exported="true" android:permission="android.permission.MANAGE_DOCUMENTS" android:grantUriPermissions="true">
   <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
  </provider>
 </application>
</manifest>
